{
  "name": "obsidian-prism",
  "version": "1.0.8-beta.5",
  "description": "Obsidian Prism (Personal TH/EN Edition) — Optical UI & Motion Suite for Antigravity by EEMEEMMEEx.",
  "license": "GPL-3.0-only",
  "author": "EEMEEMMEEx",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EEMEEMMEEx/obsidian-prism-th.git"
  },
  "homepage": "https://github.com/EEMEEMMEEx/obsidian-prism-th#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "antigravity",
    "theme",
    "optical-ui",
    "spring-motion",
    "webgl2",
    "telemetry",
    "thought-translator"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs test/gates/*.test.mjs",
    "test:gates": "node scripts/run-tests.mjs --gates",
    "test:fast": "node scripts/run-tests.mjs --fast",
    "workbench": "node workbench/server.cjs",
    "inject": "node src/inject.js",
    "watch": "node src/inject.js --watch",
    "daemon": "node sidecars/daemon/main.mjs",
    "remove": "node src/remove.js",
    "install:plugin": "node tools/install-plugin.cjs --install",
    "archive:conversations": "node sidecars/daemon/conversation-archive.mjs",
    "clean:legacy": "node tools/patch-asar.cjs --clean-legacy",
    "build:installer": "node scripts/build-installer.mjs --out dist/obsidian-prism-installer.exe",
    "build:macos": "node scripts/build-macos.mjs"
  }
}
